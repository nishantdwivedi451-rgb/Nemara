# ─────────────────────────────────────────────────────────────
# Nemara environment variables
# Copy to .env.local for development. In production set these in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# Site ─────────────────────────────────────────────────────────
# Canonical URL (custom domain). If unset, Vercel's production URL is used automatically.
NEXT_PUBLIC_SITE_URL=
# "false" hides the preview ribbon once real imagery, artist profiles and payments are live.
NEXT_PUBLIC_PREVIEW_MODE=true

# Contact (override content/site.json without a code change)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=        # digits incl. country code, e.g. 919876543210
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# Catalogue / commerce ─────────────────────────────────────────
# local   = content/products.json (default)
# shopify = Shopify Storefront API + Shopify hosted checkout
COMMERCE_PROVIDER=local
SHOPIFY_STORE_DOMAIN=               # your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=    # Storefront API token (server-only here)
SHOPIFY_API_VERSION=2025-07

# Payments (Razorpay) ──────────────────────────────────────────
# Without these, checkout runs in clearly-labelled DEMO mode (no money moves).
RAZORPAY_KEY_ID=                    # rzp_test_… or rzp_live_…
RAZORPAY_KEY_SECRET=                # SECRET — server only, mark "Sensitive" in Vercel
DEMO_PAYMENT_SECRET=

# Order & lead notifications (any or all) ──────────────────────
ORDER_WEBHOOK_URL=                  # POST JSON on every verified order (Zapier/Make/Sheets/Slack)
LEAD_WEBHOOK_URL=                   # contact + newsletter submissions
RESEND_API_KEY=                     # email notifications via resend.com
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Analytics (loaded only when set) ─────────────────────────────
NEXT_PUBLIC_GA_ID=                  # G-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# Try-on ───────────────────────────────────────────────────────
NEXT_PUBLIC_TRY_ON_PROVIDER=mediapipe
NEXT_PUBLIC_TRYON_MODEL_BASE=https://storage.googleapis.com/mediapipe-models

# Nemara Studio (/admin) ────────────────────────────────────────
ADMIN_EMAIL=                        # the only account allowed into Studio
ADMIN_PASSWORD_HASH=                # node scripts/hash-password.mjs "your-password"  (never store the plain password)
ADMIN_SESSION_SECRET=               # ≥32 random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_HOST=                         # optional dedicated hostname prefix, e.g. nemara-admin → nemara-admin.vercel.app opens Studio

# Data (Studio, orders, customers, visitors) ────────────────────
BLOB_READ_WRITE_TOKEN=              # set automatically when the private Vercel Blob store is connected
DATABASE_URL=                       # optional: Neon/Postgres — takes precedence over Blob when set (recommended at scale)
CRON_SECRET=                        # protects /api/cron/daily (Vercel Cron sends it automatically)

# Customer accounts (OTP sign-in) ────────────────────────────────
CUSTOMER_SESSION_SECRET=            # optional; defaults to a key derived from ADMIN_SESSION_SECRET
OTP_EMAIL_FROM=                     # e.g. "Nemara <hello@nemara.in>" — requires RESEND_API_KEY and a verified domain in Resend
MSG91_AUTH_KEY=                     # SMS OTP (India): MSG91 with a DLT-approved template containing ##otp##
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=                 # …or Twilio SMS
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Without an email/SMS provider, the preview edition shows codes on screen (clearly labelled); live mode refuses.
